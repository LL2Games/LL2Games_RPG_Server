      "mapId": 100000000,
      "key": "elder",
      "name": "오르",
      "role": "촌장",
      "x": 785,
      "y": 630,
      "dialogue": ["잎새마을에 온 것을 환영하네. 저 오래된 나무가 우릴 지켜 주고 있지."]
    },
    {
      "spawnId": 4,
      "npcId": 200105,
